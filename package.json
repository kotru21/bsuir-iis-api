{
  "name": "bsuir-iis-api",
  "version": "2.2.1",
  "description": "Type-safe ESM SDK for BSUIR IIS API",
  "type": "module",
  "sideEffects": false,
  "author": "kotru21",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kotru21/bsuir-iis-api.git"
  },
  "homepage": "https://github.com/kotru21/bsuir-iis-api#readme",
  "bugs": {
    "url": "https://github.com/kotru21/bsuir-iis-api/issues"
  },
  "keywords": [
    "bsuir",
    "iis",
    "schedule",
    "api",
    "sdk",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.baseline.json",
    "lint": "oxlint --type-aware --report-unused-disable-directives",
    "lint:fix": "oxlint --type-aware --report-unused-disable-directives --fix",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:live": "vitest run test/integration/live",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test",
    "check:full": "npm run lint && npm run typecheck && npm run format:check && npm run test:coverage",
    "api:report": "api-extractor run --local",
    "api:report:check": "api-extractor run",
    "smoke:dist": "node -e \"const m = require('bsuir-iis-api'); if (typeof m.createBsuirClient !== 'function') { process.exit(1); }\" && node --input-type=module -e \"const m = await import('bsuir-iis-api'); if (typeof m.createBsuirClient !== 'function') { process.exit(1); }\"",
    "prepublishOnly": "npm run build",
    "release:dry": "npm pack --dry-run"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@microsoft/api-extractor": "7.60.1",
    "@types/node": "26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint-plugin-unicorn": "79.0.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
