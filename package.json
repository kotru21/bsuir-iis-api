{
  "name": "bsuir-iis-api",
  "version": "0.7.0",
  "description": "Type-safe ESM SDK for BSUIR IIS API",
  "type": "module",
  "author": "kotru21",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kotru21/bsuir-iis-api.git"
  },
  "homepage": "https://github.com/kotru21/bsuir-iis-api#readme",
  "bugs": {
    "url": "https://github.com/kotru21/bsuir-iis-api/issues"
  },
  "keywords": [
    "bsuir",
    "iis",
    "schedule",
    "api",
    "sdk",
    "typescript"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:live": "vitest run test/integration/live-api.contract.test.ts",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test",
    "check:full": "npm run lint && npm run typecheck && npm run test:coverage",
    "api:report": "api-extractor run --local",
    "api:report:check": "api-extractor run",
    "prepublishOnly": "npm run build",
    "release:dry": "npm pack --dry-run"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.7",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
