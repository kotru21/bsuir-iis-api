{
  "name": "bsuir-iis-api",
  "version": "2.2.0",
  "description": "Type-safe ESM SDK for BSUIR IIS API",
  "type": "module",
  "sideEffects": false,
  "author": "kotru21",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kotru21/bsuir-iis-api.git"
  },
  "homepage": "https://github.com/kotru21/bsuir-iis-api#readme",
  "bugs": {
    "url": "https://github.com/kotru21/bsuir-iis-api/issues"
  },
  "keywords": [
    "bsuir",
    "iis",
    "schedule",
    "api",
    "sdk",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:live": "vitest run test/integration/live",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test",
    "check:full": "npm run lint && npm run typecheck && npm run format:check && npm run test:coverage",
    "api:report": "api-extractor run --local",
    "api:report:check": "api-extractor run",
    "prepublishOnly": "npm run build",
    "release:dry": "npm pack --dry-run"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.59.2",
    "@types/node": "26.6.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "64.5.4",
    "eslint-plugin-unicorn": "73.0.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tsdown": "0.23.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.10"
  }
}
